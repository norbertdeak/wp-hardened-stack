# Copy to .env and run `make key`. Values here are names only — never real secrets.
COMPOSE_PROJECT_NAME=wpstack

# --- pinned runtimes (the version gate may rewrite these) ---
PHP_VERSION=8.3
NGINX_VERSION=1.27
MARIADB_VERSION=11.4
REDIS_VERSION=7.4
WORDPRESS_VERSION=6.8

# --- domain / TLS ---
DOMAIN=example.test
LETSENCRYPT_EMAIL=admin@example.test

# --- generated by `make key` ---
MYSQL_ROOT_PASSWORD=__CHANGE_ME__
MYSQL_DATABASE=wordpress
MYSQL_USER=wp
MYSQL_PASSWORD=__CHANGE_ME__
REDIS_PASSWORD=__CHANGE_ME__

WP_TABLE_PREFIX=wp_
WP_DEBUG=false
